# Copy this file to .env and replace the placeholders with your own values.
# Do not add quotes around values and never commit the real .env file.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5433/opsmind
DB_USERNAME=opsmind
DB_PASSWORD=opsmind

# Qwen Embedding through Alibaba Cloud Model Studio OpenAI-compatible API
EMBEDDING_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
QWEN_EMBEDDING_DIMENSION=1024
QWEN_EMBEDDING_BATCH_SIZE=20

# Qwen Reranker uses a different endpoint from the OpenAI-compatible Embedding API.
RERANKING_PROVIDER=qwen
QWEN_RERANKING_MODEL=qwen3.7-text-rerank
QWEN_RERANK_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# Qwen Chat generation through the same OpenAI-compatible base URL as Embedding
GENERATION_PROVIDER=qwen
QWEN_CHAT_MODEL=qwen3.7-plus
QWEN_CHAT_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MINIMUM_EVIDENCE_SCORE=0.15

# Agent Planner: omit taskType in requests to enable automatic routing.
AGENT_PLANNER_PROVIDER=qwen
AGENT_PLANNER_MODEL=qwen3.7-plus
QWEN_PLANNER_MODEL=qwen3.7-plus
QWEN_PLANNER_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_PLANNER_MAX_OUTPUT_TOKENS=256
QWEN_PLANNER_CONNECT_TIMEOUT_MS=2000
QWEN_PLANNER_READ_TIMEOUT_MS=5000
QWEN_PLANNER_MAX_ATTEMPTS=2
QWEN_PLANNER_RETRY_INITIAL_BACKOFF_MS=200
QWEN_PLANNER_RETRY_MAX_BACKOFF_MS=1000
QWEN_PLANNER_CIRCUIT_FAILURE_THRESHOLD=5
QWEN_PLANNER_CIRCUIT_OPEN_DURATION_MS=30000
QWEN_PLANNER_FALLBACK_ENABLED=true
AGENT_PLANNER_FALLBACK_MODEL=local-intent-router-v2

# Local development
SWAGGER_ENABLED=true
